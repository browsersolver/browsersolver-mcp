{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.browsersolver/mcp",
  "title": "BrowserSolver",
  "description": "Unlock, render, crawl and screenshot any website — anti-bot bypass and technology detection through…",
  "version": "0.1.0",
  "websiteUrl": "https://www.browsersolver.com",
  "repository": {
    "url": "https://github.com/browsersolver/browsersolver-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@browsersolver/mcp",
      "version": "0.1.0",
      "environmentVariables": [
        {
          "name": "BROWSERSOLVER_API_KEY",
          "description": "BrowserSolver API key.",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.browsersolver.com/",
      "headers": [
        {
          "name": "x-api-key",
          "description": "BrowserSolver API key.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
